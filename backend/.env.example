# --- Base de données MySQL (Prisma ORM) ---
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DATABASE"

# Paramètres pool MySQL
LOCALHOST="localhost"
USER="USER"
PASSWORD="PASSWORD"
DATABASE="DATABASE"

# --- Sécurité & Authentification JWT ---
PRIVATEKEY="your_secret_jwt_key"

# --- URL Publique de l'API Backend ---
BASE_URL="https://api.embertongroup.com/api/"

# --- Configuration SMTP (Envoi d'emails) ---
MAIL_MAILER=smtp
MAIL_HOST=mail.privateemail.com
MAIL_PORT=465
SMTP_USER=contact@embertongroup.com
SMTP_PASS=your_smtp_password
ADMIN_EMAIL=contact@embertongroup.com
